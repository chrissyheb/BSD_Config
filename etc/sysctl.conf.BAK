#
#  This file is read when going to multi-user and its contents piped thru
#  ``sysctl'' to adjust kernel values.  ``man 5 sysctl.conf'' for details.
#

# Uncomment this to prevent users from seeing information about processes that
# are being run under another UID.
#security.bsd.see_other_uids=0

# Compress application coredumps with zstd and put them in a central location
kern.compress_user_cores=2
kern.corefile=/var/coredumps/%N-%I.core

# disable keyboard shortcuts
kern.vt.kbd_debug=0
kern.vt.kbd_halt=0
kern.vt.kbd_panic=0
kern.vt.kbd_poweroff=0
kern.vt.kbd_reboot=0

# disable mwait idle loop optimization and set hlt as default
machdep.idle="spin"
machdep.idle_mwait=0

# IP option processing is expensive and has no practical use anymore
net.inet.ip.process_options=0

# Allow users from 'usb' group to mount usb memsticks
vfs.usermount=1
vfs.zfs.min_auto_ashift=12
kern.eventtimer.periodic="1"
kern.eventtimer.timer="HPET"
kern.timecounter.hardware="TSC"
machdep.intr_rt_bypass_enable="50"
