. /etc/rc.subr

LOGTAG="neoom_routing"

log_info() { logger -t "$LOGTAG" -p user.notice -- "$*"; }
log_err()  { logger -t "$LOGTAG" -p user.err -- "$*"; }

name="neoom_routing"
rcvar="neoom_routing_enable"
start_cmd="neoom_routing_start"
stop_cmd=":"

# ---- global settings (same for all boxes) ----
EXT_IF="X000"       # external interface (matches $ext_if in neoom.vars)
LAN_IF="X001"       # internal interface
ALIAS_FIRST=1       # first host to alias (inclusive)
ALIAS_LAST=100      # last host to alias (inclusive)

RDR_FILE="/etc/pf.conf.d/neoom-rdr"

# Optional override: set e.g. NEOOM_ROUTING_OCT3="200" in /etc/rc.conf to force the mapped /24's 3rd octet.
: ${NEOOM_ROUTING_OCT3:=""}

