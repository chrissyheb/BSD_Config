neoom_routing_start()
{
  # Ensure table directory exists; *do not* overwrite mgmt_src (admin-managed).
  log_info "Starting neoom_routing..."
  
  install -d /etc/pf.tables

  # Detect external IPv4 on EXT_IF
  EXT_IP=$(ifconfig "${EXT_IF}" | awk '/inet[[:space:]]/ && $2 ~ /^([0-9]*\.){3}[0-9]*/ {print $2; exit}')
  if [ -z "${EXT_IP}" ]; then
    log_err "neoom_routing: cannot detect external IPv4 on ${EXT_IF}"
    return 1
  fi

  # Detect external IPv4 Prefix (e.g. "192.168")
  EXT_IP_PREFIX=$(echo "${EXT_IP}" | sed 's/^\([^.]*\.[^.]*\).*/\1/') # get first 2 octets of ip addres
  if [ -z "${EXT_IP_PREFIX}" ]; then
    log_info "valid prefix for external IPv4 on ${EXT_IF}"
    return 1
  fi
  
  # Derive 3rd octet if not overridden: use 4th octet from EXT_IP as 3rd octet for routing
  if [ -z "${NEOOM_ROUTING_OCT3}" ]; then
    #LAST_OCT=$(echo "${EXT_IP}" | awk -F. '{print $4}')
    #NEOOM_OCT3=$(( LAST_OCT + 91 ))
    NEOOM_ROUTING_OCT3=$(echo "${EXT_IP}" | awk -F. '{print $4}')
  fi

  # Write the mapped /24 into the xlat table file (single CIDR line).
  log_info "external IP network for routing to internal components: ${EXT_IP_PREFIX}.${NEOOM_ROUTING_OCT3}.0/16"
  echo "xlat_net = \"${EXT_IP_PREFIX}.${NEOOM_ROUTING_OCT3}.0/16\"" > /etc/pf.conf.d/neoom.dynamic

  # Ensure per-host table files exist (leave content as-is; admin manages entries).
  : > /etc/pf.tables/neoom_xlat_allow    || true
  : > /etc/pf.tables/neoom_lan_allow     || true
  : > /etc/pf.tables/neoom_lan_natonly   || true

  # Add ARP-reachable aliases for ${EXT_IP_PREFIX}.${NEOOM_ROUTING_OCT3}.ALIAS_FIRST..ALIAS_LAST
  #/usr/local/sbin/gw-aliases.sh on "${EXT_IF}" "${NEOOM_ROUTING_OCT3}" "${ALIAS_FIRST}" "${ALIAS_LAST}"

  # Build RDR per-host rules from neoom_xlat_allow
#  if build_rdr_file; then
#    log_info "generated ${RDR_FILE}"
#  else
#    log_error "failed to generate ${RDR_FILE}"
#    return 1
#  fi


  # (Re)load PF so it picks up table files & anchors
  log_info "(re)loading pf rules"
  if service pf onestatus >/dev/null 2>&1; then
    pfctl -f /etc/pf.conf
  else
    service pf start
    pfctl -f /etc/pf.conf
  fi
  log_info "ready"
}

load_rc_config $name
run_rc_command "$1"
