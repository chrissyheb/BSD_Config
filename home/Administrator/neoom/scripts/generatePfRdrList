#!/bin/sh
# write rdr list  <PREFIX_INT>.1-254 -> <PREFIX_EXT>.1-254 to a file
# Usage: writeIpsToFile <PREFIX_INT> <PREFIX_EXT> <OUTPUT_FILE>
# Example: writeIpsToFile 192.168.137 192.168.10 /etc/pf.tables/test

set -eu

usage() {
  echo "Usage: $0 <PREFIX_INT like 10.0.0> <PREFIX_PUB like 192.168.0> <OUTPUT_FILE>" >&2
  exit 1
}

[ $# -ge 3 ] || usage
PREFIX_INT="$1"
PREFIX_PUB="$2"
OUT="$3"

if [ -n "${HOST_LIST:-}" ]; then
  # generate only for hosts from list
  HOSTS=$HOST_LIST
else
  # generate for total subnet
  HOSTS=""
  i=1
  while [ $i -le 254 ]; do HOSTS="$HOSTS $i"; i=$((i+1)); done
  echo "numbers generated"
fi

validate_prefix() {
  p=$1
  [ -n "$p" ] || { echo "Prefix fehlt" >&2; return 1; }

  # In drei Oktette splitten
  oldIFS=$IFS; IFS=.
  # shellcheck disable=SC2086
  set -- $p
  IFS=$oldIFS

  [ $# -eq 3 ] || { echo "Prefix muss genau 3 Oktette haben (A.B.C)" >&2; return 1; }

  for o in "$@"; do
    # nur Ziffern
    case $o in ''|*[!0-9]*) echo "Ungültiges Oktett: '$o' (nur Ziffern erlaubt)" >&2; return 1;; esac
    # Bereich 0..255
    # (Zahlenvergleich – Fehler, wenn z. B. sehr groß/leer)
    if ! [ "$o" -ge 0 ] 2>/dev/null || ! [ "$o" -le 255 ]; then
      echo "Oktett außerhalb 0..255: '$o'" >&2; return 1
    fi
    # Optional: führende Nullen verbieten (00, 01, …), 0 selbst ist ok
    case $o in 0|[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) :;; 
      *) echo "Führende Null im Oktett: '$o'" >&2; return 1;;
    esac
  done

  return 0
}

echo "Validating prefixes"
if ! validate_prefix "$PREFIX_INT" "internal"; then exit 1; fi
if ! validate_prefix "$PREFIX_PUB" "public"; then exit 1; fi

echo "generate file"

#echo "${HOSTS}"
# schreiben
: > "$OUT"

echo "# automatically generated rdr-rules for hosts in internal network

# include global macros
include \"/etc/pf.conf.d/neoom.vars\"

# list for all internal hosts for transparent redirection" >> "$OUT"
i=0
for H in $HOSTS; do
  echo "rdr log on \$ext_if inet from <neoom_mgmt_src> to ${PREFIX_PUB}.${H} -> ${PREFIX_INT}.${H}" >> "$OUT"
  i=$((i+1))
done

echo "Wrote $(wc -l < "$OUT") lines with $i addresses to $OUT"
